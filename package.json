{
  "name": "clothes-shopping-guide",
  "version": "0.0.0",
  "private": true,
  "description": "服装购物指南 Monorepo",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
