{
  "name": "clothes-shopping-guide",
  "version": "0.0.0",
  "private": true,
  "description": "服装购物指南 Monorepo",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"pnpm --dir apps/web exec vite --host 0.0.0.0\" \"pnpm --dir apps/api exec nest start --watch\"",
    "dev:db": "docker compose -f apps/api/docker-compose.yml up -d",
    "build": "pnpm -r --if-present run build",
    "build:prod": "NODE_ENV=production pnpm --filter @clothes-shopping-guide/api build",
    "start:prod": "NODE_ENV=production pnpm --filter @clothes-shopping-guide/api start",
    "prod": "pnpm build:prod && pnpm start:prod",
    "deploy:prepare": "pnpm --filter @clothes-shopping-guide/api migration:up && pnpm --filter @clothes-shopping-guide/api seed",
    "deploy:prepare:built": "pnpm --dir apps/api exec mikro-orm migration:up --config ./dist/mikro-orm.config.js && pnpm --dir apps/api exec mikro-orm seeder:run --config ./dist/mikro-orm.config.js",
    "typecheck": "pnpm -r --if-present run typecheck",
    "migration:fresh": "pnpm --filter @clothes-shopping-guide/api migration:fresh",
    "seeder:create": "pnpm --filter @clothes-shopping-guide/api seeder:create",
    "seed": "pnpm -r --if-present run seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "3.9.10"
  }
}
