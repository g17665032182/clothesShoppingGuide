# HTTP 服务端口
PORT=3000
# API 默认按客户端 IP 限流；ttl 单位为毫秒
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
# 认证入口使用更严格的独立限流策略
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_LIMIT=10
# NODE_ENV=development 时关闭登录验证码；test 和 production 时启用

# 日志配置：可按部署环境选择级别和是否开启彩色可读输出
LOG_LEVEL=info
LOG_PRETTY=false
# 文件日志只记录 warn、error、fatal，默认写入 apps/api/logs/app.log
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log

# PostgreSQL 连接配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=clothes
DB_PASSWORD=clothes
DB_NAME=clothes_guide
# 默认启用 PostgreSQL TLS；仅连接隔离的本地/CI PostgreSQL 时设为 false
DB_SSL=true

# 开发环境开启 SQL 日志，生产环境建议设为 false
DB_DEBUG=false

# JWT 配置，生产环境必须替换为随机长密钥
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=3600
# Refresh Token 有效期（秒），实际凭证通过 HttpOnly Cookie 传递
REFRESH_TOKEN_EXPIRES_IN=2592000

# LLM 服务配置（API Key 只允许放在服务端环境变量）
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_ENABLE_LOCAL_TEST_TOOL=false
LLM_ENABLE_REMOTE_TOOLS=false
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_MS=30000
LLM_CONTEXT_WINDOW_TOKENS=128000
LLM_TOKEN_ENCODING=cl100k_base

# AI 虚拟试穿：默认关闭。开发测试仅允许配置的公开/合成图片摘要。
TRY_ON_STORAGE_DRIVER=qiniu
# 仅 development 环境可切换为 local；文件保存在 API 私有目录，不对静态资源公开。
TRY_ON_LOCAL_STORAGE_PATH=./.local-private/try-on
TRY_ON_LOCAL_PUBLIC_URL=http://localhost:3000
TRY_ON_ENABLED=false
TRY_ON_REAL_PHOTOS_ENABLED=false
TRY_ON_ALLOWED_TEST_IMAGE_SHA256=
TRY_ON_CONSENT_VERSION=v1
TRY_ON_PROVIDER=openai-compatible
TRY_ON_BASE_URL=
TRY_ON_API_KEY=
TRY_ON_MODEL=gpt-image-2.6-flare
TRY_ON_TIMEOUT_MS=150000
TRY_ON_MAX_FILE_BYTES=10485760
TRY_ON_MAX_EDGE=4096
TRY_ON_DOWNLOAD_URL_TTL_SECONDS=300
TRY_ON_QUOTA_TIME_ZONE=Asia/Shanghai
TRY_ON_POLL_INTERVAL_MS=2000
TRY_ON_PROCESSING_TIMEOUT_MS=180000
TRY_ON_RETENTION_PREFIX=try-on

# 商品分页游标签名密钥，必须使用至少 32 字符的随机值，不设置默认值
PRODUCT_QUERY_CURSOR_SECRET=

# 七牛 Kodo 私有 Bucket（只在 API 服务端配置真实凭据）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
# 可选：如不配置，SDK 会尝试自动发现区域
QINIU_REGION=

# 本地/CI Seeder 管理员账号
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_DISPLAY_NAME=系统管理员
