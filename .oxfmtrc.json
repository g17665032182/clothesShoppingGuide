{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "trailingComma": "all",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 80,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "objectWrap": "preserve",
  "proseWrap": "preserve",
  "sortPackageJson": false,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "apps/api/src/database/migrations/.snapshot-clothes_guide.json",
    "apps/api/src/metadata.ts",
    "node_modules/",
    ".agents/",
    "dist/",
    "build/",
    "coverage/"
  ]
}
