# HTTP 服务端口
PORT=3000

# 日志配置：可按部署环境选择级别和是否开启彩色可读输出
LOG_LEVEL=info
LOG_PRETTY=false

# PostgreSQL 连接配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=clothes
DB_PASSWORD=clothes
DB_NAME=clothes_guide

# 开发环境开启 SQL 日志，生产环境建议设为 false
DB_DEBUG=false

# JWT 配置，生产环境必须替换为随机长密钥
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=900

# LLM 服务配置（API Key 只允许放在服务端环境变量）
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_MS=30000
LLM_CONTEXT_WINDOW_TOKENS=128000
LLM_TOKEN_ENCODING=cl100k_base

# 本地/CI Seeder 管理员账号
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_DISPLAY_NAME=系统管理员
