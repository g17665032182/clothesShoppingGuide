{
  "name": "@clothes-shopping-guide/api",
  "version": "0.0.0",
  "private": true,
  "description": "服装购物指南后端 API",
  "type": "module",
  "mikro-orm": {
    "tsLoader": "swc"
  },
  "scripts": {
    "build": "nest build --builder swc --type-check --emit-declarations",
    "test": "node --import=@swc-node/register/esm-register --test 'src/**/*.spec.ts'",
    "start": "node dist/main.js",
    "dev": "nest start --watch --builder swc --type-check",
    "start:dev": "nest start --watch --builder swc --type-check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:create": "pnpm build && mikro-orm migration:create --config ./dist/mikro-orm.config.js",
    "migration:up": "pnpm build && mikro-orm migration:up --config ./dist/mikro-orm.config.js",
    "migration:down": "pnpm build && mikro-orm migration:down --config ./dist/mikro-orm.config.js",
    "migration:fresh": "pnpm build && mikro-orm migration:fresh --config ./dist/mikro-orm.config.js --drop-db --seed",
    "catalog:hydrate-local-try-on-images": "node --import=@swc-node/register/esm-register src/scripts/hydrate-local-test-try-on-images.ts",
    "seeder:create": "pnpm build && node ./scripts/seeder-create.mjs",
    "catalog:import": "node --import=@swc-node/register/esm-register src/scripts/import-product-catalog.ts",
    "catalog:seed:test": "pnpm build && mikro-orm seeder:run --class=ProductCatalogTestSeeder --config ./dist/mikro-orm.config.js",
    "seed": "pnpm build && mikro-orm seeder:run --config ./dist/mikro-orm.config.js"
  },
  "dependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/mcp-adapters": "^2.0.3",
    "@langchain/openai": "^1.7.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/decorators": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@mikro-orm/seeder": "7.2.5",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "6.8.0",
    "bcryptjs": "3.0.2",
    "dotenv": "17.2.2",
    "helmet": "^8.3.0",
    "js-tiktoken": "^1.0.21",
    "nestjs-pino": "^5.3.1",
    "pino-pretty": "^13.2.0",
    "qiniu": "7.15.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5",
    "svg-captcha": "1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clothes-shopping-guide/typescript-config": "workspace:*",
    "@mikro-orm/cli": "7.2.5",
    "@nestjs/cli": "12.0.10",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.20",
    "@types/node": "26.6.5",
    "@types/pg": "8.16.0",
    "typescript": "6.0.3"
  }
}
